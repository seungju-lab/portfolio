        "viewKey": "print/1440",
        "reference": "https://brittanychiang.com/"
      },
      "clip": true,
      "width": 1440,
      "fill": "$u:color.canvas",
      "layout": "vertical",
      "gap": "$u:space.section",
      "padding": [
        64,
        340,
        80,
        340
      ],
      "children": [
        {
          "type": "frame",
          "id": "wIBNF",
          "name": "Print toolbar",
          "width": "fill_container",
          "gap": "$u:space.xl",
          "justifyContent": "space_between",
          "children": [
            {
              "id": "Vh3gg",
              "type": "ref",
              "ref": "u:sHYjZ",
              "name": "홈으로",
              "height": 44,
              "descendants": {
                "u:ain5n": {
                  "icon": "arrow-left"
                },
                "u:A8C0m": {
                  "content": "홈으로"
                }
              }
            },
            {
              "id": "nRopg",
              "type": "ref",
