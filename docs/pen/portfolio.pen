                        },
                        "u:n40fhP": {
                          "content": "팀·실시간 채팅"
                        },
                        "u:CP9gf": {
                          "content": "교육생의 프로젝트 팀 구성을 돕는 서비스입니다. 팀 초대·참여 API와 WebSocket·STOMP 채팅을 구현하고 프론트엔드 연동을 담당했습니다."
                        },
                        "u:m4nuH/u:E2lqSi": {
