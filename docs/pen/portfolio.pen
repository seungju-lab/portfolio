                  "children": [
                    {
                      "id": "oEbIV",
                      "type": "ref",
                      "ref": "u:m4UfU",
                      "name": "ILOG",
                      "width": "fill_container",
                      "descendants": {
                        "u:qmO8d": {
                          "content": "2025.10 — 11"
                        },
                        "u:qDWpd": {
                          "content": "ILOG ↗"
                        },
                        "u:n40fhP": {
                          "content": "인증·사용자·그룹·Gateway"
                        },
                        "u:CP9gf": {
                          "content": "일기와 감정 분석 서비스에서 네 서비스를 단독 설계·구현했습니다. 로그인 후 사용자 조회가 다시 로그인으로 돌아가던 문제를 인증 경계를 정리해 해결했습니다."
                        },
                        "u:m4nuH/u:E2lqSi": {
                          "content": "Java"
                        },
                        "u:V8u5k5/u:E2lqSi": {
                          "content": "Spring Security"
                        },
                        "u:cgiVm/u:E2lqSi": {
                          "content": "Gateway"
                        }
                      }
                    },
                    {
                      "id": "EQdfW",
                      "type": "ref",
                      "ref": "u:m4UfU",
                      "name": "Lorekeeper",
                      "width": "fill_container",
                      "descendants": {
                        "u:qmO8d": {
                          "content": "2026.05 — 현재"
                        },
                        "u:qDWpd": {
                          "content": "Lorekeeper ↗"
                        },
                        "u:n40fhP": {
                          "content": "로그인·작품·회차"
                        },
                        "u:CP9gf": {
                          "content": "장편 창작자를 위한 작품 관리 서비스를 개발하고 있습니다. 로그인 프론트엔드·백엔드와 작품·회차 API, 원고 업로드 검증을 맡았습니다."
                        },
                        "u:m4nuH/u:E2lqSi": {
                          "content": "Spring Boot"
                        },
                        "u:V8u5k5/u:E2lqSi": {
                          "content": "OAuth2"
